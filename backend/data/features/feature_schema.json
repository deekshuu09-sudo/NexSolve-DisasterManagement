{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexSolve Canonical Landslide Risk Feature Schema (P4)",
  "version": "4.0.0",
  "description": "Canonical multi-modal feature engineering schema combining official Survey of India boundaries, NASADEM/SRTM 30m terrain, IMD rainfall, and GSI landslide inventory.",
  "features": [
    {
      "feature_name": "latitude",
      "category": "EXPOSURE_LOCATION",
      "description": "WGS84 latitude coordinate",
      "unit": "degrees_north",
      "source": "Official Survey of India / Operational Registry",
      "spatial_resolution": "Point",
      "temporal_resolution": "Static",
      "freshness": "Permanent",
      "availability": "ALWAYS_AVAILABLE",
      "derivation_method": "Geodetic coordinate",
      "missing_value_policy": "REJECT_SAMPLE",
      "leakage_risk": "NONE",
      "status": "PRODUCTION_ML"
    },
    {
      "feature_name": "longitude",
      "category": "EXPOSURE_LOCATION",
      "description": "WGS84 longitude coordinate",
      "unit": "degrees_east",
      "source": "Official Survey of India / Operational Registry",
      "spatial_resolution": "Point",
      "temporal_resolution": "Static",
      "freshness": "Permanent",
      "availability": "ALWAYS_AVAILABLE",
      "derivation_method": "Geodetic coordinate",
      "missing_value_policy": "REJECT_SAMPLE",
      "leakage_risk": "NONE",
      "status": "PRODUCTION_ML"
    },
    {
      "feature_name": "elevation_m",
      "category": "STATIC_TERRAIN",
      "description": "Surface elevation above mean sea level",
      "unit": "meters",
      "source": "USGS / AWS Open Data Elevation Archive (NASADEM / SRTM1 30m)",
      "spatial_resolution": "30 meters (1 arc-second)",
      "temporal_resolution": "Static",
      "freshness": "Permanent",
      "availability": "HIGH_AVAILABILITY",
      "derivation_method": "Bilinear lookup from 3601x3601 HGT grid",
      "missing_value_policy": "EXPLICIT_NULL",
      "leakage_risk": "NONE",
      "status": "P4_EXPERIMENTAL"
    },
    {
      "feature_name": "slope_deg",
      "category": "STATIC_TERRAIN",
      "description": "Terrain inclination angle",
      "unit": "degrees (0-90)",
      "source": "USGS / AWS Open Data Elevation Archive (NASADEM / SRTM1 30m)",
      "spatial_resolution": "30 meters (1 arc-second)",
      "temporal_resolution": "Static",
      "freshness": "Permanent",
      "availability": "HIGH_AVAILABILITY",
      "derivation_method": "3x3 Sobel gradient operator with latitude-scaled cell dimensions (dx, dy)",
      "missing_value_policy": "EXPLICIT_NULL",
      "leakage_risk": "NONE",
      "status": "P4_EXPERIMENTAL"
    },
    {
      "feature_name": "aspect_deg",
      "category": "STATIC_TERRAIN",
      "description": "Compass direction of steepest slope",
      "unit": "degrees (0-360)",
      "source": "USGS / AWS Open Data Elevation Archive (NASADEM / SRTM1 30m)",
      "spatial_resolution": "30 meters (1 arc-second)",
      "temporal_resolution": "Static",
      "freshness": "Permanent",
      "availability": "HIGH_AVAILABILITY",
      "derivation_method": "atan2(dz/dy, -dz/dx) converted to 0-360 compass bearing (0=North)",
      "missing_value_policy": "EXPLICIT_NULL",
      "leakage_risk": "NONE",
      "status": "P4_EXPERIMENTAL"
    },
    {
      "feature_name": "curvature",
      "category": "STATIC_TERRAIN",
      "description": "Profile Laplacian surface curvature",
      "unit": "1 / meter^2",
      "source": "USGS / AWS Open Data Elevation Archive (NASADEM / SRTM1 30m)",
      "spatial_resolution": "30 meters (1 arc-second)",
      "temporal_resolution": "Static",
      "freshness": "Permanent",
      "availability": "HIGH_AVAILABILITY",
      "derivation_method": "5-point discrete second-derivative Laplacian operator",
      "missing_value_policy": "EXPLICIT_NULL",
      "leakage_risk": "NONE",
      "status": "P4_EXPERIMENTAL"
    },
    {
      "feature_name": "rainfall_1d",
      "category": "DYNAMIC_WEATHER",
      "description": "24-hour accumulated rainfall observation",
      "unit": "millimeters (mm)",
      "source": "IMD High-Resolution Gridded Daily Rainfall / Weather Feed",
      "spatial_resolution": "0.25 degree (~25km)",
      "temporal_resolution": "Daily",
      "freshness": "24-hour rolling observation",
      "availability": "CONDITIONALLY_AVAILABLE",
      "derivation_method": "24h accumulated grid lookup at target lat/lon",
      "missing_value_policy": "RETURN_DATA_UNAVAILABLE_STATUS",
      "leakage_risk": "SAFE_IF_OBSERVED_PRIOR_TO_PREDICTION",
      "status": "PRODUCTION_ML"
    },
    {
      "feature_name": "rainfall_3d",
      "category": "DYNAMIC_WEATHER",
      "description": "3-day antecedent cumulative rainfall observation",
      "unit": "millimeters (mm)",
      "source": "IMD High-Resolution Gridded Daily Rainfall / Weather Feed",
      "spatial_resolution": "0.25 degree (~25km)",
      "temporal_resolution": "3-day rolling window",
      "freshness": "Daily update",
      "availability": "CONDITIONALLY_AVAILABLE",
      "derivation_method": "Sum of 3 prior consecutive days observation",
      "missing_value_policy": "RETURN_DATA_UNAVAILABLE_STATUS",
      "leakage_risk": "SAFE_IF_OBSERVED_PRIOR_TO_PREDICTION",
      "status": "PRODUCTION_ML"
    },
    {
      "feature_name": "rainfall_7d",
      "category": "DYNAMIC_WEATHER",
      "description": "7-day antecedent cumulative rainfall observation",
      "unit": "millimeters (mm)",
      "source": "IMD High-Resolution Gridded Daily Rainfall / Weather Feed",
      "spatial_resolution": "0.25 degree (~25km)",
      "temporal_resolution": "7-day rolling window",
      "freshness": "Daily update",
      "availability": "CONDITIONALLY_AVAILABLE",
      "derivation_method": "Sum of 7 prior consecutive days observation",
      "missing_value_policy": "RETURN_DATA_UNAVAILABLE_STATUS",
      "leakage_risk": "SAFE_IF_OBSERVED_PRIOR_TO_PREDICTION",
      "status": "PRODUCTION_ML"
    },
    {
      "feature_name": "month_sin",
      "category": "SEASONAL_CYCLICAL",
      "description": "Sine transform of calendar month (2*pi*month/12)",
      "unit": "unitless (-1 to +1)",
      "source": "Observation Date",
      "spatial_resolution": "Global",
      "temporal_resolution": "Monthly",
      "freshness": "Real-time",
      "availability": "ALWAYS_AVAILABLE",
      "derivation_method": "sin(2 * pi * month / 12)",
      "missing_value_policy": "DERIVE_FROM_CURRENT_DATE",
      "leakage_risk": "NONE",
      "status": "PRODUCTION_ML"
    },
    {
      "feature_name": "month_cos",
      "category": "SEASONAL_CYCLICAL",
      "description": "Cosine transform of calendar month (2*pi*month/12)",
      "unit": "unitless (-1 to +1)",
      "source": "Observation Date",
      "spatial_resolution": "Global",
      "temporal_resolution": "Monthly",
      "freshness": "Real-time",
      "availability": "ALWAYS_AVAILABLE",
      "derivation_method": "cos(2 * pi * month / 12)",
      "missing_value_policy": "DERIVE_FROM_CURRENT_DATE",
      "leakage_risk": "NONE",
      "status": "PRODUCTION_ML"
    },
    {
      "feature_name": "historical_event_count",
      "category": "LANDSLIDE_INVENTORY",
      "description": "Historical GSI landslide events recorded in district (excluding target event)",
      "unit": "count",
      "source": "Geological Survey of India (GSI) Landslide Inventory",
      "spatial_resolution": "District Level",
      "temporal_resolution": "Historical Total",
      "freshness": "Updated per inventory release",
      "availability": "HIGH_AVAILABILITY",
      "derivation_method": "Spatial join of GSI points to SOI district polygons, excluding self",
      "missing_value_policy": "EXPLICIT_ZERO",
      "leakage_risk": "STRICT_TARGET_EXCLUSION_REQUIRED",
      "status": "P4_EXPERIMENTAL"
    },
    {
      "feature_name": "event_density_per_sqkm",
      "category": "LANDSLIDE_INVENTORY",
      "description": "Historical event density per square kilometer of district area",
      "unit": "events / km^2",
      "source": "GSI Inventory / SOI District Shape Areas",
      "spatial_resolution": "District Level",
      "temporal_resolution": "Historical Total",
      "freshness": "Updated per inventory release",
      "availability": "HIGH_AVAILABILITY",
      "derivation_method": "historical_event_count / district_area_km2",
      "missing_value_policy": "EXPLICIT_ZERO",
      "leakage_risk": "STRICT_TARGET_EXCLUSION_REQUIRED",
      "status": "P4_EXPERIMENTAL"
    },
    {
      "feature_name": "distance_to_nearest_event_km",
      "category": "LANDSLIDE_INVENTORY",
      "description": "Haversine distance to nearest historical GSI landslide event (retained in historical dataset for audit/provenance)",
      "unit": "kilometers",
      "source": "GSI Landslide Inventory",
      "spatial_resolution": "Point",
      "temporal_resolution": "Static / Historical",
      "freshness": "Updated per inventory release",
      "availability": "HIGH_AVAILABILITY",
      "derivation_method": "Minimum Haversine distance to GSI inventory coordinates",
      "missing_value_policy": "EXPLICIT_NULL",
      "leakage_risk": "HIGH",
      "status": "EXCLUDED",
      "reason": "ZERO_VARIANCE_DUE_TO_SAMPLING_DESIGN",
      "production_candidate": false,
      "experimental_candidate": false
    },
    {
      "feature_name": "state_lgd",
      "category": "ADMINISTRATIVE_EXPOSURE",
      "description": "Official Local Government Directory state code",
      "unit": "integer (11-18)",
      "source": "Survey of India Administrative Boundary Data-Base (ABDB)",
      "spatial_resolution": "State Polygon",
      "temporal_resolution": "Static",
      "freshness": "Official Government Release",
      "availability": "ALWAYS_AVAILABLE",
      "derivation_method": "Point-in-polygon spatial join against ner_states_soi.geojson",
      "missing_value_policy": "EXPLICIT_NULL",
      "leakage_risk": "NONE",
      "status": "P4_EXPERIMENTAL"
    },
    {
      "feature_name": "dist_lgd",
      "category": "ADMINISTRATIVE_EXPOSURE",
      "description": "Official Local Government Directory district code",
      "unit": "integer",
      "source": "Survey of India Administrative Boundary Data-Base (ABDB)",
      "spatial_resolution": "District Polygon",
      "temporal_resolution": "Static",
      "freshness": "Official Government Release",
      "availability": "ALWAYS_AVAILABLE",
      "derivation_method": "Point-in-polygon spatial join against ner_districts_soi.geojson",
      "missing_value_policy": "EXPLICIT_NULL",
      "leakage_risk": "NONE",
      "status": "P4_EXPERIMENTAL"
    }
  ]
}
